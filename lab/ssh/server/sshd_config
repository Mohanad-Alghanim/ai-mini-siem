Port 2222
ListenAddress 0.0.0.0
HostKey /run/lab/ssh_host_ed25519_key
PidFile /run/lab/sshd.pid
AuthorizedKeysFile /run/lab/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PubkeyAuthentication yes
AuthenticationMethods publickey
PermitRootLogin no
AllowUsers labuser
UsePAM no
UseDNS no
StrictModes yes
PermitTTY no
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
MaxAuthTries 1
MaxSessions 1
MaxStartups 2
LoginGraceTime 10
LogLevel VERBOSE
ForceCommand /bin/true
